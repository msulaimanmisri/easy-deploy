{
    "name": "sulaimanmisri/easy-deploy",
    "description": "A simple Laravel package to simplify deployment commands",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Muhamad Sulaiman Misri",
            "homepage": "https://sulaimanmisri.com"
        }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "SulaimanMisri\\EasyDeploy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SulaimanMisri\\EasyDeploy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SulaimanMisri\\EasyDeploy\\EasyDeployServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}